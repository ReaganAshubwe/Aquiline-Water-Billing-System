# Admin
ADMIN_KEY=AQUALINE_ADMIN_2026

# MPESA Daraja
# true to enable real STK push requests
MPESA_ENABLED=false
# sandbox or live
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Public HTTPS callback URL (must be reachable by Safaricom)
MPESA_CALLBACK_URL=

# SMS (Africa's Talking)
# true to enable real SMS sending
SMS_ENABLED=false
SMS_PROVIDER=africastalking
SMS_API_KEY=
SMS_USERNAME=
# Optional sender ID
SMS_SENDER_ID=

# MySQL / XAMPP
# Use either MYSQL_URL or the individual connection fields below.
MYSQL_URL=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=my_db
MYSQL_TABLE_PREFIX=awbc_

# Email / Gmail OTP Authentication
EMAIL_ENABLED=true
EMAIL_SERVICE=gmail
# Your Gmail address (e.g. yourname@gmail.com)
EMAIL_USER=
# 16-character Google App Password (from https://myaccount.google.com/apppasswords)
EMAIL_APP_PASSWORD=
EMAIL_FROM="Aqualine Water Billing <support@aqualine.co.ke>"

